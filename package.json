{
  "name": "codebox",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homer0/codebox.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "packageManager": "pnpm@12.17.0",
  "engineStrict": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@homer0/object-utils": "^5.0.9",
    "fs-extra": "^11.3.6",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eclass/semantic-release-docker": "^4.0.0",
    "@homer0/oxfmt-config": "^2.0.0",
    "@homer0/oxlint-config": "^3.0.0",
    "@homer0/tsconfig": "^6.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "semantic-release": "^25.0.8",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,scss,md}": [
      "oxfmt"
    ],
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "prepare": "[ \"$NODE_ENV\" = production ] && exit 0; is-ci || husky",
    "lint": "lint-staged",
    "lint:all": "oxlint .",
    "format": "oxfmt",
    "format:all": "oxfmt .",
    "format:check": "oxfmt --check",
    "types:check": "tsc --noEmit",
    "test": "echo \"lol\"",
    "dev:setting": "./dev/scripts/settings.js",
    "dev:container:delete": "./dev/scripts/container-delete.sh",
    "predev:container:run": "pnpm run dev:container:delete",
    "dev:container:run": "./dev/scripts/container-run.sh",
    "predev:image:delete": "pnpm run dev:container:delete",
    "dev:image:delete": "./dev/scripts/image-delete.sh",
    "predev:image:build": "pnpm run dev:image:delete",
    "dev:image:build": "./dev/scripts/image-build.sh",
    "dev:all": "pnpm run dev:image:build && pnpm run dev:container:run"
  }
}
